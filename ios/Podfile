# Uncomment this line to define a global platform for your project
platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# Optimize builds
install! 'cocoapods', :deterministic_uuids => false

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks! :linkage => :dynamic

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
      config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
      config.build_settings['CODE_SIGN_IDENTITY'] = ''
      
      # Optimize for debug builds
      if config.name == 'Debug'
        config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf'
        config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES'
        config.build_settings['GCC_OPTIMIZATION_LEVEL'] = '0'
        config.build_settings['SWIFT_OPTIMIZATION_LEVEL'] = '-Onone'
        config.build_settings['ENABLE_BITCODE'] = 'NO'
      end
    end
  end
  
  # Add build phase to clear extended attributes on all frameworks BEFORE codesigning
  installer.generated_projects.each do |project|
    project.targets.each do |target|
      if target.name == 'Runner'
        # Remove existing phase if present
        existing_phases = target.shell_script_build_phases.select { |phase| phase.name == 'Clear Framework xattrs' }
        existing_phases.each { |phase| target.build_phases.delete(phase) }
        
        phase = target.new_shell_script_build_phase('Clear Framework xattrs')
        phase.shell_script = <<-SH
# Clear extended attributes on all frameworks
FRAMEWORKS_DIR="${TARGET_BUILD_DIR}/${FRAMEWORKS_FOLDER_PATH}"
if [ -d "$FRAMEWORKS_DIR" ]; then
  echo "Clearing extended attributes from frameworks in: $FRAMEWORKS_DIR"
  find "$FRAMEWORKS_DIR" -type d -name "*.framework" -exec xattr -cr {} \;
  echo "Extended attributes cleared!"
fi

# Also clear attributes on App.framework if present
APP_FRAMEWORK="${TARGET_BUILD_DIR}/${FRAMEWORKS_FOLDER_PATH}/App.framework"
if [ -d "$APP_FRAMEWORK" ]; then
  echo "Clearing extended attributes on App.framework"
  xattr -cr "$APP_FRAMEWORK"
fi
SH
        phase.input_paths = []
        
        # Insert the phase early in the build phases list (before codesigning)
        target.build_phases.insert(0, phase)
      end
    end
  end
end
